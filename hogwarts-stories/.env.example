# Скопіюй у .env і встав свої ключі.

# Claude пише сценарій: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI малює кадри: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- Необов'язкові налаштування ---
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium          # low | medium | high — глибина «обдумування» сюжету
# CLAUDE_FALLBACKS=1            # 0 — вимкнути автоматичний резервний перезапуск на іншій моделі, якщо Claude відмовить
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium   # low | medium | high (ціна й швидкість ростуть)
# IMAGE_CONCURRENCY=3           # скільки кадрів малювати одночасно
# PORT=3000
# DEMO_MODE=1                   # без ключів: заглушки замість сценарію й картинок
