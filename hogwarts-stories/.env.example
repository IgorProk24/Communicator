# Скопіюй у .env і встав свої ключі.

# Текст історії: Claude (за замовчуванням) або Grok.
# TEXT_PROVIDER=claude            # claude | grok
# Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Grok (xAI): https://console.x.ai
# XAI_API_KEY=xai-...
# GROK_MODEL=grok-4

# Картинки: достатньо ОДНОГО з ключів.
# OpenRouter (рекомендовано, швидко): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# або OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# --- Необов'язкові налаштування ---
# IMAGE_STYLE=realistic                          # realistic | comic
# IMAGE_PROVIDER=openrouter                      # openrouter | openai (за замовчуванням — той, чий ключ задано)
# OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5     # точний ID зі сторінки моделі на openrouter.ai
# OPENROUTER_IMAGE_FALLBACK=x-ai/...                       # запасна модель фото (наприклад, від xAI), якщо основна не спрацює
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=low                       # low | medium | high
# IMAGE_CONCURRENCY=5                            # скільки кадрів малювати одночасно
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium                           # low | medium | high
# CLAUDE_FALLBACKS=1                             # 0 — вимкнути резервну модель при відмові Claude
# PORT=3000
# APP_PASSWORD=...                              # пароль на сайт (для публічного хостингу)
# DEMO_MODE=1                                    # без ключів: заглушки замість сценарію й картинок
